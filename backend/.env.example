# Copy this file to backend/.env and fill in real values.
# backend/app/llm/groq_client.py calls load_dotenv() on import, so
# anything set here is picked up automatically when you run the API
# or the tests from the backend/ directory.

# -- Groq (LLM reasoning for agents) -----------------------------------
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=

# Optional overrides — sane defaults are baked in if you leave these unset.
# openai/gpt-oss-120b is Groq's current recommended general-purpose model
# (llama-3.3-70b-versatile has been deprecated). See console.groq.com/docs/models
# for the full, current list.
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_API_BASE=https://api.groq.com/openai/v1
# GROQ_TIMEOUT_SECONDS=20
# GROQ_MAX_RETRIES=2

# -- existing config (unrelated to Groq, listed here for convenience) --
# Matches docker-compose.yml's Postgres service — uncomment only if you
# need to point at something other than the default.
# DATABASE_URL=postgresql+asyncpg://reliefmesh:reliefmesh@localhost:5432/reliefmesh
# CORS_ORIGINS=*
# DEV_AUTO_CREATE_TABLES=false
